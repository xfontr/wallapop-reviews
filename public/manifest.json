{
  "manifest_version": 3,
  "name": "Wallapop reviews",
  "version": "0.1",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "./background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["./content.js"]
    }
  ],
  "permissions": [
    "webNavigation",
    "webRequest",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": ["https://es.wallapop.com/*"]
}
